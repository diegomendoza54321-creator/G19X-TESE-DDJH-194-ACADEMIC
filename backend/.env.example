# Configuración del servidor local de IA (llama.cpp / llama-server)
# Copiar este archivo a .env y ajustar los valores si es necesario.
# El backend lee estas variables mediante os.environ.get; no se carga
# .env automáticamente a menos que el proyecto lo configure explícitamente.

URL_SERVIDOR_IA=http://127.0.0.1:9931
LIMITE_CONTEXTO_IA=2048